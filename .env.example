DB_USER=your_database_user
DB_PASS=your_database_password

# Bakong KHQR
BAKONG_TOKEN=your_bakong_api_token_here
BAKONG_ACCOUNT_ID=yourname@bankname
BAKONG_MERCHANT_NAME= AiCAMBO
BAKONG_MERCHANT_CITY=PHNOM PENH
